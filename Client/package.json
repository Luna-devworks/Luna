{
  "name": "luna-client",
  "productName": "Luna",
  "version": "1.0.0",
  "description": "Luna for Windows",
  "main": "main.js",
  "author": "Luna",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.luna.client",
    "productName": "Luna",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "app/**/*",
      "server/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LunaSetup.${ext}"
    },
    "portable": {
      "artifactName": "Luna-Portable.${ext}"
    },
    "forceCodeSigning": false
  }
}